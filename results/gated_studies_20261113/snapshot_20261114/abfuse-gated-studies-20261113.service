[Unit]
Description=ABFuse full KITTI and nuScenes gated ablation studies

[Service]
Type=simple
WorkingDirectory=/home/yab/mmdetection3d
Environment=PYTHONPATH=/home/yab/mmdetection3d/work_dirs/abfuse_gated_studies_20261113_source:/home/yab/mmdetection3d
Environment=OMP_NUM_THREADS=4
ExecStart=/home/yab/miniconda3/envs/openmmlab/bin/python /home/yab/mmdetection3d/work_dirs/abfuse_gated_studies_20261113_source/projects/myfusion/tools/run_gated_studies.py queue --root /home/yab/mmdetection3d/work_dirs/gated_studies_20261113_v3
StandardOutput=append:/home/yab/mmdetection3d/work_dirs/gated_studies_20261113_v3/queue.log
StandardError=append:/home/yab/mmdetection3d/work_dirs/gated_studies_20261113_v3/queue.log
TimeoutStopSec=30
Restart=no

[Install]
WantedBy=default.target
